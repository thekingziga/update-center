# Hub listen address
PORT=8080
HOST=0.0.0.0
# Public URL of the hub (used in agent install commands). Use HTTPS in production.
#PUBLIC_URL=https://hub.example.com
# Set to 1 when running behind a reverse proxy (Caddy/nginx)
#TRUST_PROXY=1
# Time zone for update schedules
#TZ=Europe/Ljubljana
#DB_PATH=data/hub.db

# Discord — webhook (notifications only) and/or bot (commands + approval buttons)
#DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
#DISCORD_TOKEN=
#DISCORD_CHANNEL_ID=
#DISCORD_GUILD_ID=
# Comma-separated Discord user IDs allowed to manage hosts
#DISCORD_ALLOWED_USERS=

# --- Docker Compose only ---
# Where the hub port is published. Use 127.0.0.1:8080 when Caddy (https profile) is in front.
#HUB_BIND=8080
# Domain for automatic HTTPS with:  docker compose --profile https up -d
#DOMAIN=hub.example.com
# Image tag to run (default: latest)
#UC_VERSION=latest
# Agent image shown in the "Add host" Docker command
#AGENT_IMAGE=thekingziga/update-center-agent:latest
